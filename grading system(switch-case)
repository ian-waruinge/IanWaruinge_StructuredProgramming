#include <stdio.h>

int main() {

    int studentRN;
    int studentMarks;
    char studentName[100];
    char studentGrade;

  //INPUT
    printf("Enter student Registration number: ");
    scanf("%d", &studentRN);

    printf("Enter student Name: ");
    scanf("%s", studentName);

    printf("Enter student Marks: ");
    scanf("%d", &studentMarks);

 
    //control flow statements to determine the grade based on marks

   switch (studentMarks / 10) {
        case 10:
        case 9:
        case 8:
        case 7:
            studentGrade = 'A';
            break;
        case 6:
            studentGrade = 'B';
            break;
        case 5:
            studentGrade = 'C';
            break;
        case 4:
            studentGrade = 'D';
            break;
        default:
            studentGrade = 'F';
    }

    //OUTPUT

    printf("\n........STUDENT INFORMATION........\n");
    printf("Registration Number: %d\n", studentRN);
    printf(" Name: %s\n", studentName);
    printf(" Marks: %d\n", studentMarks);
    printf(" Grade: %c\n", studentGrade);
   



    return 0;
}



