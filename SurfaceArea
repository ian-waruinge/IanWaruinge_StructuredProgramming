#include <stdio.h>


int main (){

        int radius;
        double surfacearea;
        double PI = 3.14159;


        printf("Enter radius of sphere: ");
        scanf("%d", &radius);

        surfacearea =4 * PI * radius * radius;
        printf("Surface area of sphere: %.2lf\n", surfacearea);


    return 0;
}




